<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>io.github.a-n-o-d-e-r</groupId>
		<artifactId>spring-powerpoint</artifactId>
		<version>0.1.0-SNAPSHOT</version>
	</parent>

	<artifactId>spring-powerpoint-example</artifactId>

	<name>spring-powerpoint-example</name>
	<description>Spring Boot application generating a business review deck with spring-powerpoint.</description>

	<dependencies>
		<dependency>
			<groupId>io.github.a-n-o-d-e-r</groupId>
			<artifactId>spring-powerpoint-spring-boot-starter</artifactId>
			<type>pom</type>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<version>${spring-boot.version}</version>
			</plugin>

			<!--
				Regenerates the starter templates of src/main/resources/powerpoint:
				mvn -pl example exec:java@generate-templates
				They are committed, so the build itself does not run this.
			-->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>generate-templates</id>
						<goals>
							<goal>java</goal>
						</goals>
						<configuration>
							<mainClass>io.github.anoder.powerpoint.template.TemplateFixtureGenerator</mainClass>
							<arguments>
								<argument>${project.basedir}/src/main/resources/powerpoint</argument>
							</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
